# Supabase Public Client Credentials (Safe for frontend with strict RLS policies enabled)
# Create a free project at https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_ANON_KEY"

# GitHub Pages Base Path (used automatically by .github/workflows/deploy.yml)
# Leave as "/" for local development or custom domains; use "/repo-name/" for project pages
VITE_BASE_PATH="/"
